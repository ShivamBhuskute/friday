// Your custom model header
#include "friday_model_data.h"

static const char *TAG = "KWS_MAIN";

// --- Hardware & Pipeline Config ---
#define I2S_MIC_SCK 2
#define I2S_MIC_WS 15
#define I2S_MIC_SD 13
#define SAMPLE_RATE_HZ 16000
#define STEP_SAMPLES (SAMPLE_RATE_HZ * 20 / 1000)  // 20ms step
#define WINDOW_SAMPLES (SAMPLE_RATE_HZ * 1)        // 1-second window
#define SPECTROGRAM_SIZE (49 * 40)                 // Output of DSP

static i2s_chan_handle_t rx_handle;

// --- TFLite Globals ---
const tflite::Model* model = nullptr;
tflite::MicroInterpreter* interpreter = nullptr;
TfLiteTensor* input_tensor = nullptr;
TfLiteTensor* output_tensor = nullptr;

constexpr int kTensorArenaSize = 40 * 1024; // 40KB Arena for DS-CNN
static uint8_t tensor_arena[kTensorArenaSize];

// --- I2S Initialization ---
static void i2s_init(void) {
    i2s_chan_config_t chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_AUTO, I2S_ROLE_MASTER);
    ESP_ERROR_CHECK(i2s_new_channel(&chan_cfg, NULL, &rx_handle));

    i2s_std_config_t std_cfg = {
        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(SAMPLE_RATE_HZ),
        .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_32BIT, I2S_SLOT_MODE_MONO),
        .gpio_cfg = {
            .mclk = I2S_GPIO_UNUSED,
            .bclk = (gpio_num_t)I2S_MIC_SCK,
            .ws   = (gpio_num_t)I2S_MIC_WS,
            .dout = I2S_GPIO_UNUSED,
            .din  = (gpio_num_t)I2S_MIC_SD,
            .invert_flags = { .mclk_inv = false, .bclk_inv = false, .ws_inv = false },
        },
    };
    std_cfg.slot_cfg.slot_mask = I2S_STD_SLOT_LEFT;
    ESP_ERROR_CHECK(i2s_channel_init_std_mode(rx_handle, &std_cfg));
    ESP_ERROR_CHECK(i2s_channel_enable(rx_handle));
}

// --- TFLite Initialization ---
static void tflm_init(void) {
    tflite::InitializeTarget();
    model = tflite::GetModel(g_friday_model);
    if (model->version() != TFLITE_SCHEMA_VERSION) {
        ESP_LOGE(TAG, "Model schema mismatch!");
        return;
    }

    static tflite::MicroMutableOpResolver<6> micro_op_resolver;
    micro_op_resolver.AddConv2D();
    micro_op_resolver.AddDepthwiseConv2D();
    micro_op_resolver.AddAveragePool2D();
    micro_op_resolver.AddReshape();
    micro_op_resolver.AddFullyConnected();
    micro_op_resolver.AddSoftmax();

    static tflite::MicroInterpreter static_interpreter(
        model, micro_op_resolver, tensor_arena, kTensorArenaSize);
    interpreter = &static_interpreter;

    if (interpreter->AllocateTensors() != kTfLiteOk) {
        ESP_LOGE(TAG, "AllocateTensors failed.");
        return;
    }

    input_tensor = interpreter->input(0);
    output_tensor = interpreter->output(0);
    ESP_LOGI(TAG, "TFLM setup complete. Arena used: %zu bytes", interpreter->arena_used_bytes());
}

// --- Main State Machine ---
typedef enum { STATE_IDLE_LISTEN, STATE_CAPTURING } pipeline_state_t;

extern "C" void app_main(void) {
    ESP_LOGI(TAG, "Starting SIH Voice Activator...");
    i2s_init();
    tflm_init();

    int32_t *dma_chunk = (int32_t *)malloc(STEP_SAMPLES * sizeof(int32_t));
    int16_t *capture_buffer = (int16_t *)malloc(sizeof(int16_t) * WINDOW_SAMPLES);
    int8_t *spectrogram = (int8_t *)malloc(sizeof(int8_t) * SPECTROGRAM_SIZE);

    pipeline_state_t state = STATE_IDLE_LISTEN;
    int capture_fill = 0;

    while (1) {
        size_t bytes_read = 0;
        esp_err_t ret = i2s_channel_read(rx_handle, dma_chunk, STEP_SAMPLES * sizeof(int32_t), &bytes_read, portMAX_DELAY);
        if (ret != ESP_OK) continue;

        // Simplified VAD logic for demonstration: Immediately capture window
        if (state == STATE_IDLE_LISTEN) {
            // In a real scenario, check RMS energy here before transitioning
            state = STATE_CAPTURING;
            capture_fill = 0;
        } 
        
        else if (state == STATE_CAPTURING) {
            // Extract 16-bit PCM from 32-bit I2S frame
            for (int i = 0; i < STEP_SAMPLES; i++) {
                capture_buffer[capture_fill + i] = (int16_t)(dma_chunk[i] >> 16);
            }
            capture_fill += STEP_SAMPLES;

            if (capture_fill >= WINDOW_SAMPLES) {
                ESP_LOGI(TAG, "1-Second Window Captured. Running Inference...");

                // TODO: Run actual esp-dsp MFCC extraction here and write to 'spectrogram' array
                // For now, we pass the buffer directly to TFLM input tensor (simulated)
                memcpy(input_tensor->data.int8, spectrogram, SPECTROGRAM_SIZE);

                // Run the model
                if (interpreter->Invoke() != kTfLiteOk) {
                    ESP_LOGE(TAG, "Inference failed");
                } else {
                    // Extract INT8 confidence (-128 to 127)
                    int8_t score_noise = output_tensor->data.int8[0];
                    int8_t score_unknown = output_tensor->data.int8[1];
                    int8_t score_friday = output_tensor->data.int8[2];

                    // Convert to percentage (approximate mapping for standard INT8 quantization)
                    float prob_friday = (score_friday + 128) / 255.0f * 100.0f;
                    float prob_noise = (score_noise + 128) / 255.0f * 100.0f;

                    ESP_LOGI(TAG, "--- RESULTS ---");
                    ESP_LOGI(TAG, "FRIDAY:  %.1f%%", prob_friday);
                    ESP_LOGI(TAG, "NOISE:   %.1f%%", prob_noise);
                    
                    if (prob_friday > 80.0f) {
                        ESP_LOGW(TAG, ">>> KEYWORD DETECTED! <<<");
                        // Future implementation: Trigger Wi-Fi stream here
                    }
                }

                // Reset back to idle listening
                capture_fill = 0;
                state = STATE_IDLE_LISTEN;
            }
        }
    }
}
